datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  role      String   @default("USER") // "ADMIN", "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets       WalletUser[]
  transfers     WalletTransfer[]
  wishlistItems WishlistItem[]
  passkeys      Passkey[]
}

model Passkey {
  id           String   @id @default(uuid())
  name         String   @default("Ma Clé de Sécurité")
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Wallet {
  id                      String   @id @default(uuid())
  name                    String
  currency                String   @default("EUR")
  isPersonal              Boolean  @default(false)
  ownerId                 String
  carryoverMode           String   @default("NONE") // "NONE", "NEXT_MONTH", "TARGET_WALLET"
  carryoverTargetWalletId String?
  carryoverTargetWallet   Wallet?  @relation("WalletCarryoverTarget", fields: [carryoverTargetWalletId], references: [id], onDelete: SetNull)
  carryoverSources        Wallet[] @relation("WalletCarryoverTarget")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users             WalletUser[]
  revenues          Revenue[]
  recurringExpenses RecurringExpense[]
  installments      InstallmentPayment[]
  budgets           BudgetEnvelope[]
  transactions      Transaction[]
  processedPayments ProcessedPayment[]
  overrides         ExpenseOverride[]
  transfersSent     WalletTransfer[]     @relation("SentTransfers")
  transfersReceived WalletTransfer[]     @relation("ReceivedTransfers")
  wishlistItems     WishlistItem[]
}

model WalletUser {
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // "OWNER", "FULL_ACCESS", "READ_ONLY"

  @@id([walletId, userId])
}

model Revenue {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  type      String   // "FIXED", "VARIABLE", "REIMBURSEMENT", "REIMBURSEMENT_FIXED"
  month     Int      // 1-12
  year      Int      // e.g., 2026
  endMonth  Int?
  endYear   Int?
  date      DateTime @default(now())
}

model RecurringExpense {
  id         String   @id @default(uuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  title      String
  amount     Float
  category   String
  color      String   @default("blue")
  dayOfMonth Int      // 1-31
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
}

model InstallmentPayment {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  title       String
  totalAmount Float?
  amount      Float    // Montant mensuel
  category    String
  color       String   @default("violet")
  dayOfMonth  Int      // 1-31
  startMonth  Int
  startYear   Int
  endMonth    Int
  endYear     Int
}

model BudgetEnvelope {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category    String   // ex: "Alimentation", "Essence", "Loisirs"
  color       String   @default("teal")
  limitAmount Float
  month       Int
  year        Int

  @@unique([walletId, category, month, year])
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  category  String
  color     String   @default("gray")
  day       Int      // 1-31
  month     Int      // 1-12
  year      Int      // e.g., 2026
  notes     String?
  createdAt DateTime @default(now())
}

model ProcessedPayment {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId String
  type      String   // "REVENUE", "RECURRING", "INSTALLMENT"
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@unique([walletId, paymentId, type, month, year])
}

model ExpenseOverride {
  id         String   @id @default(uuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId  String
  type       String   // "REVENUE", "RECURRING", "INSTALLMENT"
  amount     Float?   // Montant spécifique pour ce mois (optionnel si uniquement désactivé)
  isDisabled Boolean  @default(false)
  month      Int      // 1-12
  year       Int
  createdAt  DateTime @default(now())

  @@unique([walletId, paymentId, type, month, year])
}

model WalletTransfer {
  id             String   @id @default(uuid())
  sourceWalletId String
  sourceWallet   Wallet   @relation("SentTransfers", fields: [sourceWalletId], references: [id], onDelete: Cascade)
  targetWalletId String
  targetWallet   Wallet   @relation("ReceivedTransfers", fields: [targetWalletId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title          String
  amount         Float
  isPercentage   Boolean  @default(false)
  percentage     Float?
  isRecurring    Boolean  @default(true)
  dayOfMonth     Int      // 1-31
  month          Int      // 1-12
  year           Int
  createdAt      DateTime @default(now())
}

model WishlistItem {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  url         String?
  category    String   @default("Général")
  notes       String?
  priority    String   @default("NORMAL") // URGENT, IMPORTANT, MAJOR, NORMAL, LOW
  status      String   @default("PENDING") // PENDING, PURCHASED, CANCELLED
  purchasedAt DateTime?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
